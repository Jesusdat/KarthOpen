          "prop": "pos_y",
          "expr": "sin(ph)*0.02"
        }
      ]
    },
    "caminar": {
      "frames": 4,
      "fps": 5,
      "bucle": true,
      "pistas": [
        {
          "pivote": "pierna_i",
          "prop": "rot_x",
          "expr": "sin(ph)*16"
        },
        {
          "pivote": "pierna_d",
          "prop": "rot_x",
          "expr": "-sin(ph)*16"
        },
        {
          "pivote": "cadera",
          "prop": "pos_y",
          "expr": "abs(sin(ph))*0.03"
        },
        {
          "pivote": "torso",
          "prop": "rot_z",
          "expr": "sin(ph)*3"
        },
        {
          "pivote": "hombro_i",
