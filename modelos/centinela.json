          "expr": "-sin(ph)*10"
        },
        {
          "pivote": "hombro_d",
          "prop": "rot_x",
          "expr": "sin(ph)*10"
        },
        {
          "pivote": "cabeza",
          "prop": "rot_y",
          "expr": "sin(ph*0.5)*20"
        }
